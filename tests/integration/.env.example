# Copy to .env and tweak if you need a non-default port or domain.

# COMPOSE_PROJECT_NAME isolates this stack from other dev environments so the
# Vaultwarden container, network, and volume can't collide with anything else.
COMPOSE_PROJECT_NAME=nautobot-secrets-vw-integration

# Host-side port that maps to Vaultwarden's port 80. Change if 18080 is taken.
VAULTWARDEN_PORT=18080

# DOMAIN is what Vaultwarden advertises in URLs (e.g. invite links). For local
# integration testing this just needs to match the URL the test client hits.
VAULTWARDEN_DOMAIN=http://localhost:18080
